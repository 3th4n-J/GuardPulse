<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- self-update from GitHub releases (user confirms every install) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility: list launchable apps for the app picker -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- find every installed browser so the site overlay works in all of them -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application>
        <!-- DNS-only filtering VPN. Bound by the system (BIND_VPN_SERVICE) and listed under Settings > VPN. -->
        <service
            android:name="za.co.guardpulse.shield.GuardVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device DNS content filter (parental/accountability blocking)" />
        </service>

        <!-- Security overlay: covers blocked apps, sites and short-video feeds. -->
        <service
            android:name="za.co.guardpulse.shield.GuardAccessibilityService"
            android:exported="false"
            android:label="@string/guardpulse_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guardpulse_accessibility" />
        </service>

        <receiver
            android:name="za.co.guardpulse.shield.UpdateReceiver"
            android:exported="false" />

        <!-- Uninstall protection. Admin is held only to block uninstall; no device management. -->
        <receiver
            android:name="za.co.guardpulse.shield.GuardDeviceAdminReceiver"
            android:description="@string/guardpulse_device_admin_description"
            android:label="@string/guardpulse_device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/guardpulse_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="za.co.guardpulse.shield.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
