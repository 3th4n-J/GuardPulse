rules_version = '2';

// GuardPulse sync: each Google account can read and write ONLY its own
// document. The document holds one AES-256-GCM encrypted blob, so even the
// project owner can't read anyone's rules, partner or activity.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/guardpulse/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // one "state" document per account, only {blob, rev}, capped in size so
      // the free quota can't be filled up; the app never deletes it
      allow create, update: if request.auth != null && request.auth.uid == uid
        && doc == 'state'
        && request.resource.data.keys().hasOnly(['blob', 'rev'])
        && request.resource.data.blob is string
        && request.resource.data.blob.size() <= 400000
        && request.resource.data.rev is int;
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
